<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <system.webServer>
        <!-- Cache prolongado para archivos estáticos -->
        <staticContent>
            <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
            <mimeMap fileExtension=".otf" mimeType="font/otf" />
            <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
        </staticContent>

        <rewrite>
            <!-- Evitar cache solo en index.html -->
            <outboundRules>
                <rule name="NoCacheIndexHtml_CacheControl" preCondition="IsIndexHtml">
                    <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
                    <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
                </rule>
                <rule name="NoCacheIndexHtml_Pragma" preCondition="IsIndexHtml">
                    <match serverVariable="RESPONSE_Pragma" pattern=".*" />
                    <action type="Rewrite" value="no-cache" />
                </rule>
                <rule name="NoCacheIndexHtml_Expires" preCondition="IsIndexHtml">
                    <match serverVariable="RESPONSE_Expires" pattern=".*" />
                    <action type="Rewrite" value="0" />
                </rule>

                <preConditions>
                    <preCondition name="IsIndexHtml">
                        <add input="{URL}" pattern="index\.html$" />
                    </preCondition>
                </preConditions>
            </outboundRules>
        </rewrite>

        <!-- Seguridad básica en cabeceras -->
        <httpProtocol>
            <customHeaders>
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="DENY" />
                <add name="Referrer-Policy" value="no-referrer" />
                <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
            </customHeaders>
        </httpProtocol>
    </system.webServer>
</configuration>